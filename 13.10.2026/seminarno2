number = int(input("Enter a number: ")) #Въвеждане на цяло число от потребителя
#ДВОИЧНА БРОЙНА СИСТЕМА
n = number #Запазваме оригиналното число в променливата n, за да можем да го използваме по-късно
binary = "" #Създаваме празен низ, който ще съдържа двоичното представяне на числото

while n > 0: #Докато n е по-голямо от 0, изпълняваме следните стъпки:
    remainder = n % 2 #Взимаме остатъка от делението на n на 2, който ще бъде 0 или 1
    binary = str(remainder) + binary #Добавяме остатъка към началото на низа binary, 
    #за да получим правилния ред на цифрите
    n = n // 2 #Делим n на 2 и запазваме резултата в n, за да продължим с по-малко число

print("Двоична система а числото е: ", binary)
#ОСМИЧНА БРОЙНА СИСТЕМА
n = number
octal = ""

while n > 0:
    remainder = n % 8 #Взимаме остатъка от делението на n на 8, който ще бъде между 0 и 7
    octal = str(remainder) + octal
    n = n // 8

print("Осмична система а числото е: ", octal)
#ШЕСТНАДЕСЕТИЧНА БРОЙНА СИСТЕМА
n = number
hexadecimal = ""
digits = "0123456789ABCDEF" #Съдържа всички цифри от 0 до 15,
#като след 9 използваме буквите A, B, C, D, E и F


while n > 0:
    remainder = n % 16 #Взимаме остатъка от делението на n на 16, който ще бъде между 0 и 15
    hexadecimal = digits[remainder] + hexadecimal
    n = n // 16

print("Шестнадесетична система а числото е: ", hexadecimal)
#ОТ ШЕСТНАДЕСЕТИЧНА В ДЕСЕТИЧНА БРОЙНА СИСТЕМА
hex_number = input("Въведете шестнадесетично число: ").upper() #Въвеждаме шестнадесетично число от потребителя
#и го преобразуваме в главни букви
decimal = 0 # Започваме десетичното число от 0.

for digit in hex_number:
    decimal = decimal * 16 + digits.index(digit) #Умножаваме натрупания резултат по 16
    # и прибавяме стойността на текущата цифра

print("Десетична система а числото е: ", decimal)
